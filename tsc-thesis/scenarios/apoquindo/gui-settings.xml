<viewsettings>
  <!-- Vista inicial centrada en el corredor. El zoom es aproximadamente
       460000 / (metros visibles a lo ancho): 350 ≈ 1,3 km, 700 ≈ 660 m. -->
  <viewport zoom="350" x="1634" y="1097"/>
  <delay value="30"/>

  <scheme name="tesis">
    <opengl antialiase="1" dither="0"/>
    <background backgroundColor="248,248,246" showGrid="0"
                gridXSize="100.00" gridYSize="100.00"/>

    <edges laneEdgeMode="0" scaleMode="0" laneShowBorders="1"
           showLinkDecals="1" showRails="1" hideConnectors="0"
           widthExaggeration="1.00" minSize="1.00" showDirection="0"
           showSublanes="1" spreadSuperposed="0" edgeParam="" laneParam=""
           vehicleParam="" vehicleScaleParam="" edgeData="" edgeDataID=""
           edgeValue="">
      <colorScheme name="uniform">
        <entry color="118,120,118"/>
      </colorScheme>
      <scalingScheme name="default"><entry color="1.0"/></scalingScheme>
    </edges>

    <!-- Coloreados por velocidad: rojo = detenido. La cola se ve sola. -->
    <vehicles vehicleMode="0" vehicleQuality="2" vehicle_minSize="3.00"
              vehicle_exaggeration="2.50" vehicle_constantSize="0"
              vehicleName_show="0" showBlinker="1">
      <colorScheme name="by speed">
        <entry color="205,45,35"  threshold="0.0"/>
        <entry color="238,160,45" threshold="4.0"/>
        <entry color="245,225,95" threshold="8.0"/>
        <entry color="70,175,105" threshold="13.0"/>
      </colorScheme>
      <scalingScheme name="default"><entry color="1.0"/></scalingScheme>
    </vehicles>

    <junctions junctionMode="0" drawShape="1"
               drawCrossingsAndWalkingareas="0" junction_minSize="1.00"
               junction_exaggeration="1.00" junctionName_show="0"
               showLane2Lane="0" showTLIndex="0" showJunctionIndex="0"/>
    <additionals addMode="0" add_minSize="1.00" add_exaggeration="1.00"/>
    <pois poi_minSize="0.00" poi_exaggeration="1.00"/>
    <polys poly_minSize="0.00" poly_exaggeration="1.00"/>
    <legend showSizeLegend="1" showColorLegend="0" showVehicleColorLegend="0"/>
  </scheme>
</viewsettings>
